# Guarded Marstek lifetime energy counters.
# Reject missing data, backwards movement, and large forward jumps.
- triggers:
    - trigger: time_pattern
      seconds: "/30"

  sensor:
    - name: "Marstek Combined Total Grid Export Clean"
      unique_id: marstek_combined_total_grid_export_clean
      unit_of_measurement: "kWh"
      device_class: energy
      state_class: total_increasing

      state: >
        {% set a = states(
          'sensor.evcc_marstek_alpha_grid_export') %}
#          'sensor.marstek_venus_e_3_0_alpha_total_grid_export') %}
        {% set b = states(
          'sensor.evcc_marstek_beta_grid_export') %}
#          'sensor.marstek_venus_e_3_0_beta_total_grid_export') %}
        {% set previous = this.state %}
        {% set max_step = 0.25 %}

        {% if is_number(a) and is_number(b) %}
          {% set candidate = (
            (a | float) + (b | float)
          ) | round(3) %}

          {% if candidate < 0 %}
            {{ previous if is_number(previous) else none }}
          {% elif not is_number(previous) %}
            {{ candidate }}
          {% else %}
            {% set delta = candidate - (previous | float) %}
            {% if 0 <= delta <= max_step %}
              {{ candidate }}
            {% else %}
              {{ previous }}
            {% endif %}
          {% endif %}
        {% else %}
          {{ previous if is_number(previous) else none }}
        {% endif %}

      attributes:
        guard_status: >
          {% set a = states(
          'sensor.evcc_marstek_alpha_grid_export') %}
#          'sensor.marstek_venus_e_3_0_alpha_total_grid_export') %}
          {% set b = states(
          'sensor.evcc_marstek_beta_grid_export') %}
#          'sensor.marstek_venus_e_3_0_beta_total_grid_export') %}

          {% if not (is_number(a) and is_number(b)) %}
            source_unavailable
          {% else %}
            {% set candidate = (
              (a | float) + (b | float)
            ) | round(3) %}
            {% if candidate < 0 %}
              rejected_negative
            {% elif not is_number(this.state) %}
              initializing
            {% else %}
              {% set delta = candidate - (this.state | float) %}
              {% if delta < 0 %}
                rejected_decrease
              {% elif delta > 0.25 %}
                rejected_jump
              {% else %}
                ok
              {% endif %}
            {% endif %}
          {% endif %}

        raw_combined_kwh: >
          {% set a = states(
          'sensor.evcc_marstek_alpha_grid_export') %}
#          'sensor.marstek_venus_e_3_0_alpha_total_grid_export') %}
          {% set b = states(
          'sensor.evcc_marstek_beta_grid_export') %}
#          'sensor.marstek_venus_e_3_0_beta_total_grid_export') %}
          {{ ((a | float) + (b | float)) | round(3)
             if is_number(a) and is_number(b) else none }}

        max_step_kwh: 0.25

    - name: "Marstek Combined Total Grid Import Clean"
      unique_id: marstek_combined_total_grid_import_clean
      unit_of_measurement: "kWh"
      device_class: energy
      state_class: total_increasing

      state: >
        {% set a = states(
          'sensor.evcc_marstek_alpha_grid_import') %}
#          'sensor.marstek_venus_e_3_0_alpha_total_grid_import') %}
        {% set b = states(
          'sensor.evcc_marstek_beta_grid_import') %}
#          'sensor.marstek_venus_e_3_0_beta_total_grid_import') %}
        {% set previous = this.state %}
        {% set max_step = 0.25 %}

        {% if is_number(a) and is_number(b) %}
          {% set candidate = (
            (a | float) + (b | float)
          ) | round(3) %}

          {% if candidate < 0 %}
            {{ previous if is_number(previous) else none }}
          {% elif not is_number(previous) %}
            {{ candidate }}
          {% else %}
            {% set delta = candidate - (previous | float) %}
            {% if 0 <= delta <= max_step %}
              {{ candidate }}
            {% else %}
              {{ previous }}
            {% endif %}
          {% endif %}
        {% else %}
          {{ previous if is_number(previous) else none }}
        {% endif %}

      attributes:
        guard_status: >
          {% set a = states(
          'sensor.evcc_marstek_alpha_grid_import') %}
#          'sensor.marstek_venus_e_3_0_alpha_total_grid_import') %}
          {% set b = states(
          'sensor.evcc_marstek_beta_grid_import') %}
#          'sensor.marstek_venus_e_3_0_beta_total_grid_import') %}

          {% if not (is_number(a) and is_number(b)) %}
            source_unavailable
          {% else %}
            {% set candidate = (
              (a | float) + (b | float)
            ) | round(3) %}
            {% if candidate < 0 %}
              rejected_negative
            {% elif not is_number(this.state) %}
              initializing
            {% else %}
              {% set delta = candidate - (this.state | float) %}
              {% if delta < 0 %}
                rejected_decrease
              {% elif delta > 0.25 %}
                rejected_jump
              {% else %}
                ok
              {% endif %}
            {% endif %}
          {% endif %}

        raw_combined_kwh: >
          {% set a = states(
          'sensor.evcc_marstek_alpha_grid_import') %}
#          'sensor.marstek_venus_e_3_0_alpha_total_grid_import') %}
          {% set b = states(
          'sensor.evcc_marstek_beta_grid_import') %}
#          'sensor.marstek_venus_e_3_0_beta_total_grid_import') %}
          {{ ((a | float) + (b | float)) | round(3)
             if is_number(a) and is_number(b) else none }}

        max_step_kwh: 0.25


    - name: "NextEnergy current price"
      unique_id: nextenergy_current_price
      unit_of_measurement: "EUR/kWh"
      device_class: monetary
      state: >
        {% set d = state_attr('sensor.enever_electricity_prices_today_2','data') %}
        {% if d %}
          {{ d[now().hour]['prijsNE'] | float }}
        {% else %}
          unknown
        {% endif %}
      attributes:
        prices: >
          {% set today = state_attr('sensor.enever_electricity_prices_today_2','data') or [] %}
          {% set tomorrow = state_attr('sensor.enever_electricity_prices_tomorrow_2','data') or [] %}
          {% set ns = namespace(items=[]) %}
          {% for r in (today + tomorrow) %}
            {% set ns.items = ns.items + [{'from': r.datum, 'price': r.prijsNE | float}] %}
          {% endfor %}
          {{ ns.items }}

    - name: "Grid Import Energy Total"
      unique_id: grid_import_energy_total
      icon: mdi:transmission-tower-import
      device_class: energy
      state_class: total_increasing
      unit_of_measurement: kWh
      availability: >-
        {{
          is_number(states('sensor.electricity_meter_energieverbruik_tarief_1'))
          and is_number(states('sensor.electricity_meter_energieverbruik_tarief_2'))
        }}
      state: >-
        {{
          (
            states('sensor.electricity_meter_energieverbruik_tarief_1') | float(0)
            + states('sensor.electricity_meter_energieverbruik_tarief_2') | float(0)
          ) | round(3)
        }}

    - name: "Grid Export Energy Total"
      unique_id: grid_export_energy_total
      icon: mdi:transmission-tower-export
      device_class: energy
      state_class: total_increasing
      unit_of_measurement: kWh
      availability: >-
        {{
          is_number(states('sensor.electricity_meter_energieproductie_tarief_1'))
          and is_number(states('sensor.electricity_meter_energieproductie_tarief_2'))
        }}
      state: >-
        {{
          (
            states('sensor.electricity_meter_energieproductie_tarief_1') | float(0)
            + states('sensor.electricity_meter_energieproductie_tarief_2') | float(0)
          ) | round(3)
        }}

    - name: "Grid Power Net"
      unique_id: grid_power_net
      icon: mdi:transmission-tower
      device_class: power
      state_class: measurement
      unit_of_measurement: W
      availability: >-
        {{
          is_number(states('sensor.electricity_meter_energieverbruik'))
          and is_number(states('sensor.electricity_meter_energieproductie'))
        }}
      state: >-
        {{
          (
            (
              states('sensor.electricity_meter_energieverbruik') | float(0)
              - states('sensor.electricity_meter_energieproductie') | float(0)
            ) * 1000
          ) | round(0)
        }}

- binary_sensor:
    - name: "Xmas lights season"
      unique_id: xmas_lights_season
      state: >
        {% set m = now().month %}
        {% set d = now().day %}
        {{ (m == 12) or (m == 1 and d <= 31) }}
      icon: mdi:string-lights

    - name: "PV Surplus"
      unique_id: pv_surplus_marstek_control
      state: >
        {{ states('sensor.net_power_filtered_for_control') | float(0) < -150 }}
      delay_on:
        minutes: 2
      delay_off:
        minutes: 2

    - name: "Negative Electricity Price"
      unique_id: negative_electricity_price_marstek_control
      state: >
        {{ states('sensor.electricity_price_eur_kwh') | float(0) < 0 }}


# Existing motion change-history sensor
- trigger:
    - platform: state
      entity_id:
        - binary_sensor.beweging_tuinkamer
      not_to:
        - unavailable
        - unknown
      not_from:
        - unavailable
        - unknown

  sensor:
    unique_id: dbf841e2-ae6f-4fc1-9534-a1046204945f
    name: Nominal Change History
    state: "OK"
    attributes:
      changes: >
        {% set current = this.attributes.get('changes', {}) %}
        {% set new = {
          trigger.entity_id:
          trigger.to_state.last_changed.isoformat()
        } %}
        {{ dict(current, **new) }}


# Nord Pool prices for today's NextEnergy-style all-in graph
- triggers:
    - trigger: homeassistant
      event: start

    - trigger: time_pattern
      minutes: "/15"

  actions:
    - action: nordpool.get_prices_for_date
      data:
        config_entry: "01M4Y5BCXBJCG6J060J50J3911"
        date: "{{ now().date() }}"
        areas:
          - NL
        currency: EUR
      response_variable: today_prices

  sensor:
    - name: "NextEnergy prices today"
      unique_id: nextenergy_prices_today
      state: "{{ now().isoformat() }}"
      attributes:
        prices: >
          {% set fee_incl_vat = 0.02190 %}
          {% set tax_incl_vat = 0.11084 %}
          {% set ns = namespace(items=[]) %}

          {% for item in today_prices.get('NL', []) %}
            {% set all_in = (
              (item.price | float) / 1000 * 1.21
              + fee_incl_vat
              + tax_incl_vat
            ) %}
            {% set ns.items = ns.items + [{
              'start': item.start,
              'end': item.end,
              'price': all_in | round(5)
            }] %}
          {% endfor %}
          {{ ns.items }}

# Separate state-based block for the derived export tariff
- sensor:
    - name: "NextEnergy electricity export tariff"
      unique_id: nextenergy_electricity_export_tariff
      unit_of_measurement: "EUR/kWh"
      state_class: measurement
      icon: mdi:transmission-tower-export

      availability: >
        {% set prices =
          state_attr('sensor.nextenergy_prices_today', 'prices') or [] %}
        {% set current = as_timestamp(now()) %}
        {% set ns = namespace(found=false) %}
        {% for item in prices %}
          {% if as_timestamp(item.start) <= current
                < as_timestamp(item.end) %}
            {% set ns.found = true %}
          {% endif %}
        {% endfor %}
        {{ ns.found }}

      state: >
        {% set prices =
          state_attr('sensor.nextenergy_prices_today', 'prices') or [] %}
        {% set current = as_timestamp(now()) %}
        {% set ns = namespace(value=none) %}

        {# Must match the components in the import sensor #}
        {% set import_fee = 0.02190 %}
        {% set import_energy_tax = 0.11084 %}
        {% set export_fee = 0.01000 %}

        {% for item in prices %}
          {% if as_timestamp(item.start) <= current
                < as_timestamp(item.end) %}
            {% set ns.value = (
              (item.price | float)
              - import_fee
              - import_energy_tax
              - export_fee
            ) | round(5) %}
          {% endif %}
        {% endfor %}
        {{ ns.value }}

      attributes:
        prices: >
          {% set prices =
            state_attr('sensor.nextenergy_prices_today', 'prices') or [] %}
          {% set ns = namespace(items=[]) %}
          {# Must match the components in the import sensor #}
          {% set import_fee = 0.02190 %}
          {% set import_energy_tax = 0.11084 %}
          {% set export_fee = 0.01000 %}
          {% for item in prices %}
            {% set export_price = (
              (item.price | float)
              - import_fee
              - import_energy_tax
              - export_fee
            ) | round(5) %}
            {% set ns.items = ns.items + [{
              'start': item.start,
              'end': item.end,
              'price': export_price
            }] %}
          {% endfor %}
          {{ ns.items }}
