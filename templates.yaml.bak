# templates.yaml
# templating: https://www.home-assistant.io/docs/configuration/templating/

- sensor:
    # Marstek via EVCC (MQTT). EVCC: + = ontladen, - = laden
    - name: "EVCC Marstek alpha charge power"
      unique_id: evcc_marstek_alpha_charge_power
      unit_of_measurement: "W"
      device_class: power
      state_class: measurement
      availability: "{{ is_number(states('sensor.evcc_marstek_alpha_power')) }}"
      state: "{{ [0, -(states('sensor.evcc_marstek_alpha_power') | float(0))] | max }}"

    - name: "EVCC Marstek beta charge power"
      unique_id: evcc_marstek_beta_charge_power
      unit_of_measurement: "W"
      device_class: power
      state_class: measurement
      availability: "{{ is_number(states('sensor.evcc_marstek_beta_power')) }}"
      state: "{{ [0, -(states('sensor.evcc_marstek_beta_power') | float(0))] | max }}"

    - name: "EVCC Marstek alpha discharge power"
      unique_id: evcc_marstek_alpha_discharge_power
      unit_of_measurement: "W"
      device_class: power
      state_class: measurement
      availability: "{{ is_number(states('sensor.evcc_marstek_alpha_power')) }}"
      state: "{{ [0, states('sensor.evcc_marstek_alpha_power') | float(0)] | max }}"

    - name: "EVCC Marstek beta discharge power"
      unique_id: evcc_marstek_beta_discharge_power
      unit_of_measurement: "W"
      device_class: power
      state_class: measurement
      availability: "{{ is_number(states('sensor.evcc_marstek_beta_power')) }}"
      state: "{{ [0, states('sensor.evcc_marstek_beta_power') | float(0)] | max }}"

    - name: "PV Temperature"
      state: "{{ state_attr('sensor.inverter_gw4200d_ns', 'tempperature') }}"
      unit_of_measurement: "°C"

    - name: "Today's PV generation East"
      state: "{{ states('sensor.goodwe_today_s_pv_generation') }}"
      unit_of_measurement: "kWh"
      device_class: energy
      state_class: total_increasing

    - name: "Total PV generation East"
      state: "{{ states('sensor.goodwe_total_pv_generation') }}"
      unit_of_measurement: "kWh"
      device_class: energy
      state_class: total_increasing

    - name: "Today's PV generation West"
      state: "{{ states('sensor.sunnyboy_today_s_energy_supply') }}"
      unit_of_measurement: "kWh"
      device_class: energy
      state_class: total_increasing

    - name: "Electricity Total Energy Production Filtered"
      unique_id: electricity_total_energy_production_filtered
      unit_of_measurement: "kWh"
      device_class: energy
      state_class: total_increasing
      state: >
        {% set t1 = states('sensor.electricity_meter_energy_production_tarif_1') | float(0) %}
        {% set t2 = states('sensor.electricity_meter_energy_production_tarif_2') | float(0) %}
        {% set new = (t1 + t2) | round(3) %}
        {% set old_str = states(this.entity_id) %}
        {% if old_str in ['unknown', 'unavailable', 'none', ''] %}
          {{ new }}
        {% else %}
          {% set old = old_str | float(new) %}
          {% if new < old %}
            {{ old }}
          {% elif (new - old) > 1 %}
            {{ old }}
          {% else %}
            {{ new }}
          {% endif %}
        {% endif %}

    - name: "Electricity Total Energy Consumption Filtered"
      unique_id: electricity_total_energy_consumption_filtered
      unit_of_measurement: "kWh"
      device_class: energy
      state_class: total_increasing
      state: >
        {% set t1 = states('sensor.electricity_meter_energy_consumption_tarif_1') | float(0) %}
        {% set t2 = states('sensor.electricity_meter_energy_consumption_tarif_2') | float(0) %}
        {% set new = (t1 + t2) | round(3) %}
        {% set old_str = states(this.entity_id) %}
        {% if old_str in ['unknown', 'unavailable', 'none', ''] %}
          {{ new }}
        {% else %}
          {% set old = old_str | float(new) %}
          {% if new < old %}
            {{ old }}
          {% elif (new - old) > 1 %}
            {{ old }}
          {% else %}
            {{ new }}
          {% endif %}
        {% endif %}

    - name: "Electricity Price EUR kWh"
      unique_id: electricity_price_eur_kwh_marstek_control
      unit_of_measurement: "EUR/kWh"
      state_class: measurement
      state: >
        {{ states('sensor.current_electricity_price_all_in') | float(0) }}

    - name: "NextEnergy electricity all-in"
      unique_id: nextenergy_electricity_all_in
      unit_of_measurement: "EUR/kWh"
      state_class: measurement
      availability: >
        {{ is_number(states('sensor.nord_pool_nl_huidige_prijs')) }}
      state: >
        {% set market = states('sensor.nord_pool_nl_huidige_prijs') | float(0) %}
        {% set purchase_fee_incl_vat = 0.02190 %}
        {% set energy_tax_incl_vat = 0.11084 %}
        {{ (market * 1.21
            + purchase_fee_incl_vat
            + energy_tax_incl_vat) | round(5) }}


    - name: "Marstek Combined Grid Power"
      unique_id: marstek_combined_grid_power
      unit_of_measurement: "W"
      device_class: power
      state_class: measurement
      state: >
        {# sign = -1: zelfde teken als oude Marstek-sensor (laden = +). Zet op 1 als het omgekeerd blijkt. #}
        {% set sign = -1 %}
        {% set alpha = states('sensor.evcc_marstek_alpha_power') | float(0) %}
        {% set beta  = states('sensor.evcc_marstek_beta_power') | float(0) %}
        {{ ((alpha + beta) * sign) | round(0) }}

    - name: "Marstek Combined Total Grid Export"
      unique_id: marstek_combined_total_grid_export
      unit_of_measurement: "kWh"
      device_class: energy
      state_class: total_increasing
      state: >
        {% set alpha = states('sensor.evcc_marstek_alpha_grid_export') | float(0) %}
        {% set beta  = states('sensor.evcc_marstek_beta_grid_export') | float(0) %}
        {{ (alpha + beta) | round(3) }}
      availability: >
        {{ is_number(states('sensor.evcc_marstek_alpha_grid_export'))
           and is_number(states('sensor.evcc_marstek_beta_grid_export')) }}

    - name: "Marstek Combined Total Grid Import"
      unique_id: marstek_combined_total_grid_import
      unit_of_measurement: "kWh"
      device_class: energy
      state_class: total_increasing
      state: >
        {% set alpha = states('sensor.evcc_marstek_alpha_grid_import') | float(0) %}
        {% set beta  = states('sensor.evcc_marstek_beta_grid_import') | float(0) %}
        {{ (alpha + beta) | round(3) }}
      availability: >
        {{ is_number(states('sensor.evcc_marstek_alpha_grid_import'))
           and is_number(states('sensor.evcc_marstek_beta_grid_import')) }}

